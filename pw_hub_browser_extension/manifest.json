{
  "manifest_version": 3,
  "name": "PW Hub Session Import",
  "version": "1.0.1",
  "description": "Securely imports the current PW Online browser session into the selected PW Hub account.",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:43827/*",
    "https://pwonline.ru/*",
    "https://*.pwonline.ru/*",
    "https://pw.mail.ru/*",
    "https://*.pw.mail.ru/*"
  ],
  "action": {
    "default_title": "Import PW session",
    "default_popup": "popup.html"
  }
}
