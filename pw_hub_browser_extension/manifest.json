{
  "manifest_version": 3,
  "name": "Обмен сессиями PW Hub",
  "version": "1.1.0",
  "description": "Безопасно переносит сессии PW Online между Chrome или Edge и выбранным аккаунтом PW Hub.",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:43827/*",
    "https://pwonline.ru/*",
    "https://*.pwonline.ru/*",
    "https://pw.mail.ru/*",
    "https://*.pw.mail.ru/*"
  ],
  "action": {
    "default_title": "Обмен сессиями PW Hub",
    "default_popup": "popup.html"
  }
}
