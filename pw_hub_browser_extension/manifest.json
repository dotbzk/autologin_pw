{
  "manifest_version": 3,
  "name": "Импорт сессии PW Hub",
  "version": "1.0.2",
  "description": "Безопасно импортирует текущую браузерную сессию PW Online в выбранный аккаунт PW Hub.",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:43827/*",
    "https://pwonline.ru/*",
    "https://*.pwonline.ru/*",
    "https://pw.mail.ru/*",
    "https://*.pw.mail.ru/*"
  ],
  "action": {
    "default_title": "Импортировать сессию PW",
    "default_popup": "popup.html"
  }
}
